    GROUPBOX "Lift Minimum Height", 1022, 145, 55, 75, 40
    GROUPBOX "Lift Maximum Height", 1021, 145, 100, 75, 40
    GROUPBOX "Start Direction", 1019, 5, 130, 130, 40, WS_GROUP
