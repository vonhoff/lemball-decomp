#include <windows.h>

#define IDR_MAIN_MENU 115

#define IDM_FILE_EXIT 40001
#define IDM_HELP_CONTENTS 40003
#define IDM_HELP_ABOUT 40011
#define IDM_OPTIONS_FULLSCREEN 40012
#define IDM_HELP_ON_HELP 40013
#define IDM_HELP_SEARCH_TOPIC 40016

LANGUAGE 9, 2

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", IDM_FILE_EXIT
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "Full Screen        F4", IDM_OPTIONS_FULLSCREEN
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents", IDM_HELP_CONTENTS
        MENUITEM "&Search Topic", IDM_HELP_SEARCH_TOPIC
        MENUITEM "&Help on Help", IDM_HELP_ON_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About Paint Ball...", IDM_HELP_ABOUT
    END
END

ABOUTBOX DIALOG 22, 17, 167, 184
STYLE DS_SETFONT | WS_POPUP | WS_BORDER
FONT 8, "System"
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 132, 2, 32, 14, WS_GROUP
    ICON 117, -1, 3, 2, 18, 20
    LTEXT "CompanyName", 1024, 25, 10, 100, 8
    LTEXT "FileDescription", 1025, 25, 20, 82, 8
    LTEXT "ProductVersion", 1026, 110, 20, 50, 8
    LTEXT "\2511996 Psygnosis Ltd.", 1027, 25, 30, 137, 8
    LTEXT "LegalTrademarks", 1028, 25, 50, 136, 16
    LTEXT "Memory Size", 283, 9, 77, 151, 96
    CONTROL "", 501, "STATIC", WS_VISIBLE | WS_CHILD | SS_BLACKRECT, 25, 40, 138, 1
    GROUPBOX "Information", -1, 5, 67, 159, 111
END

101 DIALOG 0, 0, 186, 95
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_POPUP | WS_VISIBLE | WS_SYSMENU
CAPTION "Please Enter Level Name (32 Characters)"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT 1000, 10, 15, 165, 20, WS_VISIBLE | WS_TABSTOP | WS_CHILD | WS_BORDER | ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 35, 75, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 100, 75, 50, 14
    GROUPBOX "Level Name", -1, 5, 5, 175, 40
END

104 DIALOG 0, 0, 227, 201
