{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 15,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc400",
      "displayName": "MSVC 4.00",
      "generator": "NMake Makefiles",
      "binaryDir": "${sourceDir}/build-msvc400",
      "toolchainFile": "${sourceDir}/cmake/msvc400-toolchain.cmake",
      "environment": {
        "MSVC400_ROOT": "${sourceDir}/msvc400",
        "INCLUDE": "${sourceDir}/msvc400/include",
        "LIB": "${sourceDir}/msvc400/lib",
        "PATH": "${sourceDir}/msvc400/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/msvc400/bin/nmake.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc400",
      "configurePreset": "msvc400",
      "environment": {
        "MSVC400_ROOT": "${sourceDir}/msvc400",
        "INCLUDE": "${sourceDir}/msvc400/include",
        "LIB": "${sourceDir}/msvc400/lib",
        "PATH": "${sourceDir}/msvc400/bin;$penv{PATH}"
      },
      "targets": ["LEMBALL"]
    }
  ]
}
